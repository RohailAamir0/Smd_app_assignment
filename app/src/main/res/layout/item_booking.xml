<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Movie Poster (left) -->
        <ImageView
            android:id="@+id/imgBookingPoster"
            android:layout_width="75dp"
            android:layout_height="100dp"
            android:layout_marginEnd="14dp"
            android:scaleType="centerCrop"
            android:src="@drawable/dark_knight"
            android:contentDescription="Movie poster" />

        <!-- Movie Info (center) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBookingMovieName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Movie Name" />

            <TextView
                android:id="@+id/tvBookingDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:drawableStart="@android:drawable/ic_menu_recent_history"
                android:drawablePadding="4dp"
                android:text="Date &amp; Time" />

            <TextView
                android:id="@+id/tvBookingSeats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:drawableStart="@android:drawable/ic_menu_manage"
                android:drawablePadding="4dp"
                android:text="Seats" />

            <TextView
                android:id="@+id/tvBookingPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#E53935"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="$0" />

        </LinearLayout>

        <!-- Cancel Button (right) -->
        <Button
            android:id="@+id/btnCancelBooking"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_red_rounded"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="0dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
